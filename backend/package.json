{
  "name": "music-bot-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "doctor": "node --import tsx src/doctor.ts",
    "update:ytdlp": "node --import tsx src/doctor.ts --update-ytdlp",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "play-dl": "^1.9.7",
    "socket.io": "^4.7.5",
    "voicemeeter-connector": "^2.2.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
